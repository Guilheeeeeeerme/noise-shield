generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  google
  apple
  facebook
}

model User {
  id               String         @id @default(uuid()) @db.Uuid
  provider         AuthProvider
  providerSubject  String         @map("provider_subject")
  email            String?
  displayName      String?        @map("display_name")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  lastLoginAt      DateTime       @map("last_login_at") @db.Timestamptz

  preferences      UserPreference[]
  favorites        FavoriteProfile[]
  consent          ConsentRecord?
  feedback         SessionFeedback[]
  features         AcousticFeatureSubmission[]
  experiments      ExperimentAssignment[]

  @@unique([provider, providerSubject])
  @@map("users")
}

model UserPreference {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  key              String
  value            Json
  serverReceivedAt DateTime @map("server_received_at") @db.Timestamptz
  clientUpdatedAt  DateTime? @map("client_updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_preferences")
}

model FavoriteProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  soundId          String   @map("sound_id")
  label            String?
  sortOrder        Int      @default(0) @map("sort_order")
  serverReceivedAt DateTime @map("server_received_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, soundId])
  @@map("favorite_profiles")
}

model ConsentRecord {
  userId                 String    @id @map("user_id") @db.Uuid
  acousticFeaturesOptIn  Boolean   @default(false) @map("acoustic_features_opt_in")
  consentedAt            DateTime? @map("consented_at") @db.Timestamptz
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz
  policyVersion          String    @map("policy_version")
  serverReceivedAt       DateTime  @map("server_received_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consent_records")
}

model SessionFeedback {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  sessionId         String   @map("session_id")
  soundId           String   @map("sound_id")
  suggestedProfile  String?  @map("suggested_profile")
  helpful           Boolean
  submittedAt       DateTime @default(now()) @map("submitted_at") @db.Timestamptz
  context           Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, submittedAt(sort: Desc)])
  @@map("session_feedback")
}

model AcousticFeatureSubmission {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  sessionId            String   @map("session_id")
  featureSchemaVersion String   @map("feature_schema_version")
  features             Json
  broadProfileLabel    String?  @map("broad_profile_label")
  capturedAt           DateTime @map("captured_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([capturedAt])
  @@map("acoustic_feature_submissions")
}

model RemoteConfiguration {
  id          String   @id
  version     Int
  payload     Json
  publishedAt DateTime @map("published_at") @db.Timestamptz

  @@map("remote_configurations")
}

model ExperimentAssignment {
  userId        String   @map("user_id") @db.Uuid
  experimentKey String   @map("experiment_key")
  variant       String
  assignedAt    DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, experimentKey])
  @@map("experiment_assignments")
}
