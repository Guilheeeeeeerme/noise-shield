# Enforce LF for all text in the repo and working tree.
# Overrides local core.autocrlf so Linux/Windows/macOS clones stay identical.
* text=auto eol=lf

# Explicit text types (belt-and-suspenders)
*.kt       text eol=lf
*.kts      text eol=lf
*.java     text eol=lf
*.xml      text eol=lf
*.gradle   text eol=lf
*.properties text eol=lf
*.pro      text eol=lf
*.md       text eol=lf
*.mdc      text eol=lf
*.txt      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.csv      text eol=lf
*.svg      text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.c        text eol=lf
*.cc       text eol=lf
*.cpp      text eol=lf
*.cxx      text eol=lf
*.h        text eol=lf
*.hpp      text eol=lf
*.cmake    text eol=lf
*.sh       text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf

# Shell / wrapper must stay LF even on Windows
gradlew    text eol=lf

# Windows-only scripts need CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Binary — never touch line endings
*.jar      binary
*.so       binary
*.a        binary
*.o        binary
*.class    binary
*.dex      binary
*.apk      binary
*.aab      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.mp3      binary
*.wav      binary
*.ogg      binary
*.flac     binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.pdf      binary
*.zip      binary
*.gz       binary
*.7z       binary
*.keystore binary
*.jks      binary
